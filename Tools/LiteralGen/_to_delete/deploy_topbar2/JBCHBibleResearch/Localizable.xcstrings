    "배포 페이지에 저작권 표시 문구의 구체적 예시나 앱 내 임베딩에 대한 별도 조항은 없어, 위 문구는 페이지에 명시된 라이선스 조건과 폰트 파일에 내장된 저작권 고지를 그대로 옮긴 것입니다." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Vertriebsseite nennt weder ein konkretes Beispiel für den Urheberrechtsvermerk noch gesonderte Bedingungen für die Einbettung in Apps. Der obige Text gibt daher die auf der Seite genannten Lizenzbedingungen und den in der Schriftdatei eingebetteten Urheberrechtsvermerk wieder."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "The distribution page gives no specific example of the copyright notice or separate terms for embedding in apps, so the text above reproduces the license terms stated on the page and the copyright notice embedded in the font file."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "The distribution page gives no specific example of the copyright notice or separate terms for embedding in apps, so the text above reproduces the licence terms stated on the page and the copyright notice embedded in the font file."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La página de distribución no ofrece un ejemplo concreto del aviso de derechos de autor ni condiciones específicas para incrustarla en apps, por lo que el texto anterior reproduce las condiciones de licencia indicadas en la página y el aviso de derechos de autor incrustado en el archivo de la fuente."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La página de distribución no ofrece un ejemplo concreto del aviso de derechos de autor ni condiciones específicas para incrustarla en apps, por lo que el texto anterior reproduce las condiciones de licencia indicadas en la página y el aviso de derechos de autor incrustado en el archivo de la fuente."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Walang partikular na halimbawa ng copyright notice ang distribution page o hiwalay na tuntunin para sa pag-embed sa app, kaya kinopya ng teksto sa itaas ang mga kondisyon ng lisensya na nakasaad sa page at ang copyright notice na naka-embed sa font file."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La page de distribution ne donne ni exemple précis de mention de droits d’auteur ni conditions particulières pour l’intégration dans une app ; le texte ci-dessus reprend donc les conditions de licence indiquées sur la page et la mention de droits d’auteur intégrée au fichier de police."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La page de distribution ne donne ni exemple précis de mention de droits d’auteur ni conditions particulières pour l’intégration dans une app ; le texte ci-dessus reprend donc les conditions de licence indiquées sur la page et la mention de droits d’auteur intégrée au fichier de police."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Halaman distribusi tidak memberikan contoh khusus pemberitahuan hak cipta maupun ketentuan terpisah untuk penyematan di aplikasi, sehingga teks di atas menyalin ketentuan lisensi yang tercantum di halaman dan pemberitahuan hak cipta yang tertanam dalam file font."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La pagina di distribuzione non fornisce esempi specifici della nota di copyright né termini separati per l'incorporamento nelle app, quindi il testo sopra riproduce le condizioni di licenza indicate nella pagina e la nota di copyright incorporata nel file del font."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "配布ページには著作権表示文の具体例やアプリへの埋め込みに関する個別の条項がないため、上の文言はページに明記されたライセンス条件とフォントファイルに埋め込まれた著作権表示をそのまま記載したものです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A página de distribuição não traz exemplo específico do aviso de direitos autorais nem termos separados para incorporação em apps, por isso o texto acima reproduz as condições de licença indicadas na página e o aviso de direitos autorais incorporado ao arquivo da fonte."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "На странице распространения нет конкретного примера уведомления об авторских правах и отдельных условий встраивания в приложения, поэтому текст выше воспроизводит условия лицензии, указанные на странице, и уведомление об авторских правах, встроенное в файл шрифта."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "หน้าเผยแพร่ไม่มีตัวอย่างข้อความแสดงลิขสิทธิ์ที่เจาะจง หรือข้อกำหนดแยกสำหรับการฝังในแอป ข้อความด้านบนจึงคัดลอกเงื่อนไขสัญญาอนุญาตที่ระบุในหน้าและประกาศลิขสิทธิ์ที่ฝังอยู่ในไฟล์แบบอักษรมาตามเดิม"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Trang phân phối không có ví dụ cụ thể về câu ghi bản quyền hay điều khoản riêng cho việc nhúng vào ứng dụng, nên nội dung trên trích nguyên điều kiện giấy phép ghi trên trang và thông báo bản quyền được nhúng trong tệp phông chữ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "发布页面上没有著作权声明文字的具体示例，也没有关于嵌入 App 的单独条款，因此上方文字照录了页面上注明的许可条件和字体文件中内嵌的著作权声明。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "釋出頁面上沒有著作權宣告文字的具體示例，也沒有關於嵌入 App 的單獨條款，因此上方文字照錄了頁面上註明的許可條件和字型檔案中內嵌的著作權宣告。"
          }
        }
      }
    },
