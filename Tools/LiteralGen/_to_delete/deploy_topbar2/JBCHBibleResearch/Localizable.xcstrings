    "업로드할 파일 %lld개와 관련된 성경 장을 지정하면, 성경 조회(S1) 화면에서 이 문서를 바로 찾아볼 수 있습니다. 나중에 문서 목록에서 다시 바꾸거나 해제할 수 있습니다." : {
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "needs_review",
                  "value" : "Wenn du das Bibelkapitel zu der %lld hochzuladenden Datei festlegst, findest du dieses Dokument direkt auf dem Bibelbildschirm. Du kannst es später in der Dokumentliste ändern oder entfernen."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "needs_review",
                  "value" : "Wenn du das Bibelkapitel zu den %lld hochzuladenden Dateien festlegst, findest du diese Dokumente direkt auf dem Bibelbildschirm. Du kannst es später in der Dokumentliste ändern oder entfernen."
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "needs_review",
                  "value" : "If you set the Bible chapter related to the %lld file you're uploading, you can find this document right from the Bible screen. You can change or remove it later in the document list."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "needs_review",
                  "value" : "If you set the Bible chapter related to the %lld files you're uploading, you can find these documents right from the Bible screen. You can change or remove it later in the document list."
                }
              }
            }
          }
        },
        "en-CA" : {
