          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "En el modo Mover, un dedo desplaza el lienzo. En el modo Seleccionar, un dedo selecciona o mueve nodos y dos dedos desplazan el lienzo."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "needs_review",
