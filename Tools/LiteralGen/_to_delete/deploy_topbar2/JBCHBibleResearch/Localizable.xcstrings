        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Số chương của sách %lld (%lld chương) khác với cấu trúc Kinh Thánh chuẩn (%lld chương).\nCách đánh số sách của tệp này có thể khác với thứ tự chính điển mà ứng dụng giả định."
          }
        },
        "zh-Hans" : {
