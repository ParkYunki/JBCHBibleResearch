    "3개가 모두 사용 중이라 %@은(는) 꺼진 상태로 추가되었습니다. 켜려면 먼저 다른 번역본을 꺼 주세요." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Alle 3 Plätze sind belegt, daher wurde %@ deaktiviert hinzugefügt. Deaktiviere zuerst eine andere Übersetzung, um sie zu aktivieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "All 3 slots are in use, so %@ was added turned off. To turn it on, turn off another translation first."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "All 3 slots are in use, so %@ was added turned off. To turn it on, turn off another translation first."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las 3 posiciones están en uso, así que %@ se añadió desactivada. Para activarla, desactiva primero otra traducción."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las 3 posiciones están en uso, así que %@ se agregó desactivada. Para activarla, desactiva primero otra traducción."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ginagamit na ang 3 slot, kaya idinagdag ang %@ nang naka-off. Para i-on ito, i-off muna ang ibang salin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les 3 emplacements sont utilisés : %@ a donc été ajoutée désactivée. Pour l’activer, désactivez d’abord une autre traduction."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les 3 emplacements sont utilisés : %@ a donc été ajoutée désactivée. Pour l’activer, désactivez d’abord une autre traduction."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ketiga slot sedang digunakan, jadi %@ ditambahkan dalam keadaan nonaktif. Untuk mengaktifkannya, nonaktifkan terjemahan lain terlebih dahulu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tutti e 3 gli slot sono in uso, quindi %@ è stata aggiunta disattivata. Per attivarla, disattiva prima un'altra traduzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "3つすべてが使用中のため、%@ はオフの状態で追加されました。オンにするには、先に別の訳をオフにしてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Os 3 espaços estão em uso, então %@ foi adicionada desativada. Para ativá-la, desative primeiro outra tradução."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Все 3 места заняты, поэтому %@ добавлен выключенным. Чтобы включить его, сначала выключите другой перевод."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ทั้ง 3 ช่องถูกใช้อยู่ จึงเพิ่ม %@ ในสถานะปิด หากต้องการเปิด โปรดปิดฉบับแปลอื่นก่อน"
