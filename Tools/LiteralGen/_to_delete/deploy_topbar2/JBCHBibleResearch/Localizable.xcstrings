    "부모 선도 '점점 얇게'라서, 부모 선이 끝난 굵기에서 이어 시작합니다." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Auch die übergeordnete Linie verjüngt sich, daher beginnt diese Linie bei der Stärke, mit der die übergeordnete Linie endet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "The parent line also tapers, so this line starts at the thickness where the parent line ends."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "The parent line also tapers, so this line starts at the thickness where the parent line ends."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La línea padre también se adelgaza, así que esta empieza con el grosor en que termina la línea padre."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La línea padre también se adelgaza, así que esta empieza con el grosor en que termina la línea padre."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Numinipis din ang linya ng magulang, kaya nagsisimula ang linyang ito sa kapal kung saan nagtatapos ang linya ng magulang."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La ligne parente s’affine aussi : cette ligne commence donc à l’épaisseur où se termine la ligne parente."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La ligne parente s’affine aussi : cette ligne commence donc à l’épaisseur où se termine la ligne parente."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Garis induk juga menipis, jadi garis ini dimulai pada ketebalan tempat garis induk berakhir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Anche la linea genitore si assottiglia, quindi questa linea parte dallo spessore in cui termina la linea genitore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "親の線も「だんだん細く」なので、親の線が終わった太さから続けて始まります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A linha pai também afina, então esta linha começa na espessura em que a linha pai termina."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Родительская линия тоже сужается, поэтому эта линия начинается с толщины, на которой заканчивается родительская."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "เส้นของโหนดแม่ก็ “ค่อยๆ บางลง” เช่นกัน เส้นนี้จึงเริ่มต่อจากความหนาที่เส้นของโหนดแม่สิ้นสุด"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Đường của nút cha cũng “thon dần”, nên đường này bắt đầu tiếp từ độ dày nơi đường của nút cha kết thúc."
