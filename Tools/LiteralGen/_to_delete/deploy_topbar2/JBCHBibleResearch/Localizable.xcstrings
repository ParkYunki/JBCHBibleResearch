    "개인 묵상을 기록하고, 자주 보는 장·절은 책갈피로 저장해 언제든 빠르게 돌아올 수 있습니다." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Halte persönliche Andachten fest und setze Lesezeichen für häufig gelesene Kapitel und Verse, um schnell dorthin zurückzukehren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Record personal devotions and bookmark the chapters and verses you visit often so you can return to them quickly."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Record personal devotions and bookmark the chapters and verses you visit often so you can return to them quickly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Escribe tus devocionales personales y guarda como marcadores los capítulos y versículos que más consultas para volver a ellos rápidamente."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Escribe tus devocionales personales y guarda como marcadores los capítulos y versículos que más consultas para volver a ellos rápidamente."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Itala ang iyong personal na debosyon at i-bookmark ang mga kabanata at talatang madalas mong buksan para mabilis kang makabalik anumang oras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Notez vos méditations personnelles et ajoutez des signets aux chapitres et versets que vous consultez souvent pour y revenir rapidement."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Notez vos méditations personnelles et ajoutez des signets aux chapitres et versets que vous consultez souvent pour y revenir rapidement."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Catat renungan pribadi dan simpan pasal serta ayat yang sering Anda buka sebagai penanda agar dapat kembali dengan cepat kapan saja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Annota le tue meditazioni personali e aggiungi segnalibri ai capitoli e versetti che consulti spesso per ritornarci rapidamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "個人の黙想を記録し、よく開く章・節をブックマークに保存して、いつでもすぐに戻れます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Registre seus devocionais pessoais e salve como favoritos os capítulos e versículos que você visita com frequência para voltar a eles rapidamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Записывайте личные размышления и сохраняйте часто открываемые главы и стихи в закладки, чтобы быстро возвращаться к ним."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "บันทึกการเฝ้าเดี่ยวส่วนตัว และบันทึกบทและข้อที่เปิดบ่อยไว้เป็นบุ๊กมาร์ก เพื่อกลับไปได้อย่างรวดเร็วทุกเมื่อ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ghi lại các bài tĩnh nguyện cá nhân và lưu những chương, câu bạn hay mở vào dấu trang để nhanh chóng quay lại bất cứ lúc nào."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "记录个人灵修，并将常看的章节保存为书签，随时快速返回。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "記錄個人靈修，並將常看的章節儲存為書籤，隨時快速返回。"
          }
        }
      }
    },
