    "아이폰 하단 메뉴에 \"통합 검색\" 탭을 새로 추가했습니다. \"개요\"는 \"더보기\" 메뉴 안에서 볼 수 있습니다." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Neuer Tab „Suche“ in der Tableiste des iPhone. „Gliederung“ befindet sich jetzt im Menü „Mehr“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Added a new \"Search\" tab to the iPhone tab bar. \"Outline\" is now in the \"More\" menu."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Added a new \"Search\" tab to the iPhone tab bar. \"Outline\" is now in the \"More\" menu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se añadió una nueva pestaña «Búsqueda» a la barra inferior del iPhone. «Esquema» ahora está en el menú «Más»."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se agregó una nueva pestaña “Búsqueda” a la barra inferior del iPhone. “Esquema” ahora está en el menú “Más”."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nagdagdag ng bagong tab na \"Hanapin\" sa tab bar ng iPhone. Nasa menu na \"Higit Pa\" na ngayon ang \"Balangkas\"."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nouvel onglet « Recherche » dans la barre inférieure de l’iPhone. « Plan » se trouve désormais dans le menu « Plus »."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nouvel onglet « Recherche » dans la barre inférieure de l’iPhone. « Plan » se trouve désormais dans le menu « Plus »."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tab \"Cari\" baru ditambahkan ke bar tab iPhone. \"Garis Besar\" kini ada di menu \"Lainnya\"."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aggiunta una nuova scheda \"Cerca\" alla barra delle schede di iPhone. \"Schema\" ora si trova nel menu \"Altro\"."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "iPhone の下部メニューに「検索」タブを新しく追加しました。「概要」は「その他」メニューの中にあります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nova aba \"Busca\" adicionada à barra de abas do iPhone. \"Esboço\" agora fica no menu \"Mais\"."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "На панель вкладок iPhone добавлена вкладка «Поиск». «План» теперь находится в меню «Ещё»."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "เพิ่มแท็บ \"ค้นหา\" ใหม่ในแถบเมนูด้านล่างของ iPhone ส่วน \"โครงร่าง\" ดูได้ในเมนู \"เพิ่มเติม\""
          }
        },
        "vi" : {
