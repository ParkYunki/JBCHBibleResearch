    "성경 조회 화면에 책갈피 기능을 추가했습니다. 자주 보는 장·절을 저장해 두고, 목록에서 골라 바로 이동할 수 있습니다." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lesezeichen im Bibelbildschirm hinzugefügt. Speichere häufig gelesene Kapitel und Verse und springe direkt aus der Liste dorthin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Added bookmarks to the Bible screen. Save chapters and verses you visit often and jump to them right from the list."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Added bookmarks to the Bible screen. Save chapters and verses you visit often and jump to them right from the list."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se añadieron marcadores a la pantalla de la Biblia. Guarda los capítulos y versículos que más consultas y ve a ellos directamente desde la lista."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se agregaron marcadores a la pantalla de la Biblia. Guarda los capítulos y versículos que más consultas y ve a ellos directamente desde la lista."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Idinagdag ang mga bookmark sa screen ng Biblia. I-save ang mga kabanata at talatang madalas mong buksan at pumunta agad sa mga ito mula sa listahan."
          }
        },
        "fr" : {
