    "폴더를 만들어 개인 묵상을 묶어 보세요. 묵상을 끌어다 놓거나 행을 길게 눌러(우클릭) 옮길 수 있습니다." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Erstelle Ordner, um deine Andachten zu gruppieren. Ziehe Andachten auf einen Ordner oder drücke lange auf eine Zeile (Rechtsklick), um sie zu verschieben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Create folders to group your personal devotions. Drag devotions onto a folder, or long-press (right-click) a row to move it."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Create folders to group your personal devotions. Drag devotions onto a folder, or long-press (right-click) a row to move it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Crea carpetas para agrupar tus devocionales. Arrastra los devocionales a una carpeta o mantén pulsada una fila (clic derecho) para moverla."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Crea carpetas para agrupar tus devocionales. Arrastra los devocionales a una carpeta o mantén presionada una fila (clic derecho) para moverla."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gumawa ng mga folder para pangkatin ang iyong personal na debosyon. I-drag ang mga debosyon sa isang folder, o pindutin nang matagal (right-click) ang isang row para ilipat ito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Créez des dossiers pour regrouper vos méditations. Faites glisser une méditation sur un dossier, ou maintenez une ligne appuyée (clic droit) pour la déplacer."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Créez des dossiers pour regrouper vos méditations. Faites glisser une méditation sur un dossier, ou maintenez une ligne appuyée (clic droit) pour la déplacer."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Buat folder untuk mengelompokkan renungan pribadi Anda. Seret renungan ke folder, atau tekan lama (klik kanan) sebuah baris untuk memindahkannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Crea cartelle per raggruppare le tue meditazioni personali. Trascina le meditazioni su una cartella oppure tieni premuta (clic destro) una riga per spostarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "フォルダを作成して個人の黙想をまとめましょう。黙想をドラッグ&ドロップするか、行を長押し (右クリック) して移動できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Crie pastas para agrupar seus devocionais pessoais. Arraste devocionais para uma pasta ou toque e segure (clique com o botão direito) uma linha para movê-la."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Создавайте папки для группировки личных размышлений. Перетащите размышление на папку или нажмите и удерживайте (правый клик) строку, чтобы переместить её."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "สร้างโฟลเดอร์เพื่อจัดกลุ่มการเฝ้าเดี่ยวส่วนตัว ลากการเฝ้าเดี่ยวไปวางบนโฟลเดอร์ หรือกดค้าง (คลิกขวา) ที่แถวเพื่อย้าย"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tạo thư mục để nhóm các bài tĩnh nguyện cá nhân. Kéo thả bài tĩnh nguyện vào thư mục, hoặc nhấn giữ (nhấp chuột phải) một hàng để di chuyển."
          }
