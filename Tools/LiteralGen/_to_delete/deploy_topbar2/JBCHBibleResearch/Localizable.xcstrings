    "이동은 한 손가락으로 화면을 움직이고, 선택은 한 손가락으로 선택하거나 노드를 움직이며 두 손가락으로 화면을 움직입니다." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Im Modus „Bewegen“ verschiebt ein Finger die Arbeitsfläche. Im Modus „Auswählen“ wählt oder bewegt ein Finger Knoten, und zwei Finger verschieben die Arbeitsfläche."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "In Move mode, one finger pans the canvas. In Select mode, one finger selects or moves nodes and two fingers pan the canvas."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "In Move mode, one finger pans the canvas. In Select mode, one finger selects or moves nodes and two fingers pan the canvas."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
