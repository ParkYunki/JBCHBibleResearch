    "선마다 끝이 시작의 60%까지 얇아지고, 루트에서 4단계째 선부터는 굵기가 일정한 실선입니다." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jede Linie verjüngt sich auf 60 % ihrer Anfangsstärke; ab der 4. Ebene unter dem Stamm sind die Linien durchgezogen mit gleichbleibender Stärke."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Each line thins to 60% of its starting width, and from the 4th level below the root the lines are solid with a constant width."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Each line thins to 60% of its starting width, and from the 4th level below the root the lines are solid with a constant width."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cada línea se adelgaza hasta el 60% de su grosor inicial y, a partir del 4.º nivel bajo la raíz, las líneas son continuas con grosor constante."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cada línea se adelgaza hasta el 60% de su grosor inicial y, a partir del 4.º nivel bajo la raíz, las líneas son continuas con grosor constante."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Numinipis ang bawat linya hanggang 60% ng simulang lapad nito, at mula sa ika-4 na antas sa ibaba ng root, solid na ang mga linya na may pare-parehong lapad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chaque ligne s’affine jusqu’à 60 % de son épaisseur initiale ; à partir du 4e niveau sous la racine, les lignes sont pleines avec une épaisseur constante."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chaque ligne s’affine jusqu’à 60 % de son épaisseur initiale ; à partir du 4e niveau sous la racine, les lignes sont pleines avec une épaisseur constante."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Setiap garis menipis hingga 60% dari lebar awalnya, dan mulai dari level ke-4 di bawah akar garisnya padat dengan lebar tetap."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ogni linea si assottiglia fino al 60% dello spessore iniziale e, dal 4° livello sotto la radice, le linee sono continue con spessore costante."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "各線の終端は始点の 60% まで細くなり、ルートから4段階目以降の線は太さが一定の実線になります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cada linha afina até 60% da largura inicial e, a partir do 4º nível abaixo da raiz, as linhas são sólidas com largura constante."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Каждая линия сужается до 60% начальной толщины, а начиная с 4-го уровня от корня линии сплошные и постоянной толщины."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ปลายของแต่ละเส้นจะบางลงถึง 60% ของจุดเริ่มต้น และตั้งแต่ระดับที่ 4 จากรากลงไป เส้นจะเป็นเส้นทึบที่มีความหนาคงที่"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mỗi đường thon dần đến 60% độ dày ban đầu, và từ cấp thứ 4 tính từ gốc trở đi là đường liền có độ dày cố định."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "每条线的末端会细到起点的 60%，从根往下第 4 级起的线条为粗细恒定的实线。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "每條線的末端會細到起點的 60%，從根往下第 4 級起的線條為粗細恆定的實線。"
          }
        }
      }
    },
