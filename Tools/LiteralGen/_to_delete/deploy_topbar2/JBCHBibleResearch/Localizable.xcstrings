    "같은 메모·문서에 태그를 함께 붙이면 자동으로, 태그끼리 드래그해 놓으면 수동으로 연결됩니다." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tags werden automatisch verknüpft, wenn sie gemeinsam an derselben Notiz oder demselben Dokument verwendet werden, oder manuell, wenn du ein Tag auf ein anderes ziehst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tags are linked automatically when used together on the same note or document, or manually when you drag one tag onto another."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tags are linked automatically when used together on the same note or document, or manually when you drag one tag onto another."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las etiquetas se vinculan automáticamente cuando se usan juntas en la misma nota o documento, o manualmente al arrastrar una etiqueta sobre otra."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las etiquetas se vinculan automáticamente cuando se usan juntas en la misma nota o documento, o manualmente al arrastrar una etiqueta sobre otra."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Awtomatikong naiuugnay ang mga tag kapag sabay na ginamit sa iisang tala o dokumento, o mano-mano kapag dinrag mo ang isang tag sa ibabaw ng isa pa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les étiquettes sont liées automatiquement lorsqu’elles sont utilisées ensemble sur une même note ou un même document, ou manuellement en faisant glisser une étiquette sur une autre."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les étiquettes sont liées automatiquement lorsqu’elles sont utilisées ensemble sur une même note ou un même document, ou manuellement en faisant glisser une étiquette sur une autre."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tag ditautkan otomatis jika digunakan bersama dalam catatan atau dokumen yang sama, atau secara manual jika Anda menyeret satu tag ke tag lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "I tag vengono collegati automaticamente quando sono usati insieme nella stessa nota o documento, oppure manualmente trascinando un tag su un altro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "同じメモや文書にタグを一緒に付けると自動で、タグ同士をドラッグして重ねると手動でつながります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "As tags são vinculadas automaticamente quando usadas juntas na mesma anotação ou documento, ou manualmente quando você arrasta uma tag sobre outra."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Теги связываются автоматически, если используются вместе в одной заметке или документе, или вручную, если перетащить один тег на другой."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "แท็กจะเชื่อมโยงกันโดยอัตโนมัติเมื่อใช้ร่วมกันในบันทึกหรือเอกสารเดียวกัน หรือเชื่อมโยงด้วยตนเองเมื่อลากแท็กหนึ่งไปวางบนอีกแท็ก"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Các thẻ được liên kết tự động khi dùng chung trong cùng một ghi chú hoặc tài liệu, hoặc liên kết thủ công khi bạn kéo một thẻ thả lên thẻ khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "在同一笔记或文档中同时使用标签会自动关联，把一个标签拖到另一个标签上则手动关联。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "在同一筆記或文件中同時使用標籤會自動關聯，把一個標籤拖到另一個標籤上則手動關聯。"
          }
        }
      }
    },
